# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fda_adverse_events
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_EVENTS=raw_adverse_events
KAFKA_CONSUMER_GROUP=fda_pipeline

# OpenFDA API (no key required, but rate limited)
FDA_API_BASE_URL=https://api.fda.gov/drug/event.json
FDA_API_RATE_LIMIT=240  # requests per minute

# Pipeline Settings
BATCH_SIZE=1000
LOOKBACK_DAYS=30
ENABLE_BACKFILL=false

# Monitoring
LOG_LEVEL=INFO
ALERT_EMAIL=your_email@example.com

# Dashboard
STREAMLIT_PORT=8501
